{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Only the runtime-agnostic helpers. index.ts is excluded because it is Deno
  // -only (Deno.serve, npm: specifiers) and tsc cannot resolve those without
  // the Deno toolchain; its correctness is covered by the manual run in
  // docs/DEPLOYMENT.md.
  "include": ["supabase/functions/**/lib/**/*.ts"]
}
